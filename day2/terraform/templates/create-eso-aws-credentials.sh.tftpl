#!/bin/bash
set -euo pipefail

# Script này được Terraform render sau khi tạo IAM access key cho ESO.
# Chạy script trên máy có kubectl trỏ vào minikube cluster.
kubectl create namespace external-secrets --dry-run=client -o yaml | kubectl apply -f -

kubectl create secret generic aws-secretsmanager-creds \
  --namespace external-secrets \
  --from-literal=access-key='${access_key_id}' \
  --from-literal=secret-access-key='${secret_access_key}' \
  --dry-run=client -o yaml | kubectl apply -f -
